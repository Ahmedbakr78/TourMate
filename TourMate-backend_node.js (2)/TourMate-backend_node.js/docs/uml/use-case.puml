@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actor {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
}
skinparam usecase {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}

actor "Tourist" as T
actor "Admin" as A
actor "Driver" as D
actor "Guide" as G

rectangle "TourMate System" {
  usecase UC1 as "Register"
  usecase UC2 as "Login"
  usecase UC3 as "Manage Profile"
  usecase UC4 as "Search Places"
  usecase UC5 as "Create Trip"
  usecase UC6 as "Vote on Places"
  usecase UC7 as "Share Trip"
  usecase UC8 as "Join Shared Trip"
  usecase UC9 as "Manage Reviews"
  usecase UC10 as "Manage Lost Items"
  usecase UC11 as "Manage Drivers"
  usecase UC12 as "Manage Guides"
  usecase UC13 as "Manage Vehicles"
  usecase UC14 as "Dashboard"
  usecase UC15 as "Approve/Reject"
  usecase UC16 as "Track Location"
  usecase UC17 as "Update Availability"
}

T --> UC1
T --> UC2
T --> UC3
T --> UC4
T --> UC5
T --> UC6
T --> UC7
T --> UC8
T --> UC9
T --> UC10

A --> UC11
A --> UC12
A --> UC13
A --> UC14
A --> UC15
A --> UC2
A --> UC3

D --> UC16
D --> UC17
D --> UC2
D --> UC3

G --> UC2
G --> UC3
G --> UC17

UC7 .> UC8 : extends
UC5 .> UC6 : includes
UC9 .> UC5 : includes
UC15 .> UC11 : extends
UC15 .> UC12 : extends

@enduml
